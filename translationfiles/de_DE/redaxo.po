#: l10n-sources/toolkit-strings.php:15
#, php-format
msgid "%1$s (renamed)"
msgstr "%1$s (umbenannt)"

#: l10n-sources/toolkit-strings.php:16
msgid "App-data root folder does not exist."
msgstr "Das Wurzelverzeichnis der App-Daten existiert nicht."

#: l10n-sources/toolkit-strings.php:17
#, php-format
msgid "App-storage sub-folder \"%s\" does not exist and cannot be created."
msgstr ""
"Das App-Unterverzeichnis \"%s\" existiert nicht und kann nicht angelegt "
"werden."

#: l10n-sources/toolkit-strings.php:18
#, php-format
msgid ""
"Archive format of \"%1$s\" detected as \"%2$s\", but there is no backend "
"driver installed which can decompress \".%3$s\" files."
msgstr ""
"Das Archivformat von \"%1$s\" wurde als \"%2$s\" erkannt, aber es ist kein "
"Backend-Treiber installiert, der \".%3$s\"-Dateien entpacken kann."

#: l10n-sources/toolkit-strings.php:19
msgid "Cloud installation problem: instance ID is missing."
msgstr "Problem mit der Cloud-Installation: Die Instanz-ID fehlt."

#: l10n-sources/toolkit-strings.php:20
#, php-format
msgid "Collection \"%1$s\" in entity of type \"%2$s\" is null."
msgstr "Die Sammlung \"%1$s\" in der Entität vom Typ \"%2$s\" ist null."

#: l10n-sources/toolkit-strings.php:21
#, php-format
msgid "Converter \"%1$s\" has failed trying to convert MIME type \"%2$s\""
msgstr ""
"Der Konverter \"%1$s\" ist bei der Umwandlung des MIME-Typs \"%2$s\" "
"fehlgeschlagen."

#: l10n-sources/toolkit-strings.php:22
#, php-format
msgid "Error response from call to internal route \"%1$s\": %2$s"
msgstr "Fehlerantwort auf den Aufruf der internen Route \"%1$s\": %2$s"

#: l10n-sources/toolkit-strings.php:23
#, php-format
msgid "Error response from call to internal route \"%1$s\": %2$s --  %3$s"
msgstr ""
"Fehlerantwort auf den Aufruf der internen Route \"%1$s\": %2$s --  %3$s"

#: l10n-sources/toolkit-strings.php:24
#, php-format
msgid ""
"Exactly one of query-parameters \"%1$s\" and \"%2$s\" have to be specified."
msgstr ""
"Genau einer der Abfrageparameter \"%1$s\" und \"%2$s\" muss angegeben werden."

#: l10n-sources/toolkit-strings.php:25
msgid "Installation instructions:"
msgstr "Installationsanleitung:"

#: l10n-sources/toolkit-strings.php:26
#, php-format
msgid ""
"Installation problem; the required resource \"%1$s\" of type \"%2$s\" is not "
"installed on the server, please contact the system administrator!"
msgstr ""
"Installationsproblem; die benötigte Ressource \"%1$s\" vom Typ \"%2$s\" ist "
"auf dem Server nicht installiert, bitte wenden Sie sich an den "
"Systemadministrator!"

#: l10n-sources/toolkit-strings.php:27
#, php-format
msgid "Invalid OCS response from call to internal route \"%1$s\": %2$s"
msgstr "Ungültige OCS-Antwort auf den Aufruf der internen Route \"%1$s\": %2$s"

#: l10n-sources/toolkit-strings.php:28
#, php-format
msgid "Invalid response from API call: \"%s\""
msgstr "Ungültige Antwort auf den API-Aufruf: \"%s\""

#: l10n-sources/toolkit-strings.php:29
msgid "Login failed."
msgstr "Anmeldung fehlgeschlagen."

#: l10n-sources/toolkit-strings.php:30
msgid "Login succeeded."
msgstr "Anmeldung erfolgreich."

#: l10n-sources/toolkit-strings.php:31
msgid "Password"
msgstr "Passwort"

#: l10n-sources/toolkit-strings.php:32
#, php-format
msgid "Please install the \"%s\" program on the server."
msgstr "Bitte installieren Sie das Programm \"%s\" auf dem Server."

#: l10n-sources/toolkit-strings.php:33
#, php-format
msgid ""
"Shared folder for mount-point \"%1$s\" already exists, cannot create it."
msgstr ""
"Der freigegebene Ordner für den Einhängepunkt \"%1$s\" existiert bereits und "
"kann nicht angelegt werden."

#: l10n-sources/toolkit-strings.php:34
#, php-format
msgid ""
"Shared folder for mount-point \"%1$s\" does not exist, cannot add group "
"\"%2$s\"."
msgstr ""
"Der freigegebene Ordner für den Einhängepunkt \"%1$s\" existiert nicht, die "
"Gruppe \"%2$s\" kann nicht hinzugefügt werden."

#: l10n-sources/toolkit-strings.php:35
#, php-format
msgid ""
"Shared folder for mount-point \"%1$s\" does not exist, cannot change its "
"mount-point to \"%2$s\"."
msgstr ""
"Der freigegebene Ordner für den Einhängepunkt \"%1$s\" existiert nicht, sein "
"Einhängepunkt kann nicht in \"%2$s\" geändert werden."

#: l10n-sources/toolkit-strings.php:36
#, php-format
msgid ""
"Shared folder for mount-point \"%1$s\" does not exist, cannot modify manager "
"\"%2$s\"."
msgstr ""
"Der freigegebene Ordner für den Einhängepunkt \"%1$s\" existiert nicht, der "
"Verwalter \"%2$s\" kann nicht geändert werden."

#: l10n-sources/toolkit-strings.php:37
#, php-format
msgid ""
"Shared folder for mount-point \"%1$s\" does not exist, cannot remove group "
"\"%2$s\"."
msgstr ""
"Der freigegebene Ordner für den Einhängepunkt \"%1$s\" existiert nicht, die "
"Gruppe \"%2$s\" kann nicht entfernt werden."

#: l10n-sources/toolkit-strings.php:38
#, php-format
msgid ""
"Shared folder for mount-point \"%1$s\" does not exist, cannot set "
"permissions for group \"%2$s\"."
msgstr ""
"Der freigegebene Ordner für den Einhängepunkt \"%1$s\" existiert nicht, die "
"Berechtigungen für die Gruppe \"%2$s\" können nicht gesetzt werden."

#: l10n-sources/toolkit-strings.php:39
#, php-format
msgid "Shared folder with ID \"%1$s\" does not exist."
msgstr "Der freigegebene Ordner mit der ID \"%1$s\" existiert nicht."

#: l10n-sources/toolkit-strings.php:40
#, php-format
msgid ""
"Supported data formats are \"%1$s\" and \"%2$s\", specified was \"%3$s\"."
msgstr ""
"Unterstützte Datenformate sind \"%1$s\" und \"%2$s\", angegeben wurde "
"\"%3$s\"."

#: l10n-sources/toolkit-strings.php:41
#, php-format
msgid ""
"The \"%1$s\" driver claims to handle this format, but cannot extract the "
"archive content."
msgstr ""
"Der Treiber \"%1$s\" gibt an, dieses Format zu verarbeiten, kann den "
"Archivinhalt aber nicht entpacken."

#: l10n-sources/toolkit-strings.php:42
#, php-format
msgid "The \"%1$s\" driver could handle this format, but it is not installed."
msgstr ""
"Der Treiber \"%1$s\" könnte dieses Format verarbeiten, ist aber nicht "
"installiert."

#: l10n-sources/toolkit-strings.php:43
#, php-format
msgid ""
"The archive format of \"%1$s\" has been detected as \"%2$s\", but there is "
"no backend driver installed which can deal with this format."
msgstr ""
"Das Archivformat von \"%1$s\" wurde als \"%2$s\" erkannt, aber es ist kein "
"Backend-Treiber installiert, der mit diesem Format umgehen kann."

#: l10n-sources/toolkit-strings.php:44
msgid "The input color values are invalid."
msgstr "Die Eingabe-Farbwerte sind ungültig."

#: l10n-sources/toolkit-strings.php:45
#, php-format
msgid "The supplied color-string \"%s\" seems to be invalid."
msgstr "Die angegebene Farbzeichenkette \"%s\" scheint ungültig zu sein."

#: l10n-sources/toolkit-strings.php:46
msgid "There is no archive file associated with this archiver instance."
msgstr "Mit dieser Archivierer-Instanz ist keine Archivdatei verbunden."

#: l10n-sources/toolkit-strings.php:47
#, php-format
msgid "Unable to compute a serialization for an instance of \"%s\"."
msgstr ""
"Für eine Instanz von \"%s\" kann keine Serialisierung berechnet werden."

#: l10n-sources/toolkit-strings.php:48
msgid ""
"Unable to deal with tar-files. Please check the installation of the app."
msgstr ""
"Tar-Dateien können nicht verarbeitet werden. Bitte überprüfen Sie die "
"Installation der App."

#: l10n-sources/toolkit-strings.php:49
#, php-format
msgid "Unable to detect the archive format of \"%1$s\"."
msgstr "Das Archivformat von \"%1$s\" kann nicht erkannt werden."

#: l10n-sources/toolkit-strings.php:50
#, php-format
msgid "Unable to determine the identifier values for an instance of \"%s\"."
msgstr ""
"Die Identifikatorwerte für eine Instanz von \"%s\" können nicht bestimmt "
"werden."

#: l10n-sources/toolkit-strings.php:51
#, php-format
msgid ""
"Unable to determine the version of the helper program \"%1$s\", is it "
"installed?"
msgstr ""
"Die Version des Hilfsprogramms \"%1$s\" kann nicht bestimmt werden, ist es "
"installiert?"

#: l10n-sources/toolkit-strings.php:52
#, php-format
msgid "Unable to find any of the fallback converters \"%s\"."
msgstr "Keiner der Ersatz-Konverter \"%s\" kann gefunden werden."

#: l10n-sources/toolkit-strings.php:53
#, php-format
msgid "Unable to find the entity \"%1$s\" identified by \"%2$s\"."
msgstr ""
"Die durch \"%2$s\" identifizierte Entität \"%1$s\" kann nicht gefunden "
"werden."

#: l10n-sources/toolkit-strings.php:54
#, php-format
msgid "Unable to open archive file %s (%s)"
msgstr "Die Archivdatei %s (%s) kann nicht geöffnet werden."

#: l10n-sources/toolkit-strings.php:55
msgid "Unable to register types with DBAL."
msgstr "Typen können nicht bei DBAL registriert werden."

#: l10n-sources/toolkit-strings.php:56
#, php-format
msgid "Unable to sanitize filename \"%s\"."
msgstr "Der Dateiname \"%s\" kann nicht bereinigt werden."

#: l10n-sources/toolkit-strings.php:57
#, php-format
msgid "Unable to serve request to \"%1$s\": %2$s"
msgstr "Die Anfrage an \"%1$s\" kann nicht bearbeitet werden: %2$s"

#: l10n-sources/toolkit-strings.php:58
#, php-format
msgid "Uncompressed size of archive \"%1$s\" is too large: %2$s > %3$s"
msgstr "Die unkomprimierte Größe des Archivs \"%1$s\" ist zu groß: %2$s > %3$s"

#: l10n-sources/toolkit-strings.php:59
#, php-format
msgid ""
"Universal converter \"%1$s\" has failed trying to convert MIME type \"%2$s\""
msgstr ""
"Der Universalkonverter \"%1$s\" ist bei der Umwandlung des MIME-Typs "
"\"%2$s\" fehlgeschlagen."

#: l10n-sources/toolkit-strings.php:60
#, php-format
msgid "Unknown search topic \"%1$s\""
msgstr "Unbekanntes Suchthema \"%1$s\""

#: l10n-sources/toolkit-strings.php:61
msgid "User"
msgstr "Benutzer"

#: l10n-sources/toolkit-strings.php:62
msgid "bytes"
msgstr "Bytes"

#: l10n-sources/toolkit-strings.php:63
msgid "not found"
msgstr "nicht gefunden"

#: l10n-sources/toolkit-strings.php:64
msgid "pass through"
msgstr "durchgereicht"

#: l10n-sources/toolkit-strings.php:65
msgid "renamed file"
msgstr "umbenannte Datei"

#: lib/Controller/PageController.php:90
msgid ""
"Please tell a system administrator to configure the URL for the Redaxo "
"instance"
msgstr ""
"Bitte bitten Sie einen Systemadministrator, die URL der Redaxo-Instanz zu "
"konfigurieren."

