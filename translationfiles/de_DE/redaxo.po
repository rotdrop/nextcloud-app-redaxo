#, php-format
msgid "Unknown admin setting: \"%1$s\""
msgstr "Unbekannte Administrationseinstellung: \"%1$s\""

#: lib/Controller/SettingsController.php:124
#, php-format
msgid "The admin setting \"%1$s\" is read-only"
msgstr "Die Administrationseinstellung \"%1$s\" ist schreibgeschützt."

#: lib/Controller/SettingsController.php:145
msgid ""
"Scheme of external URL must be one of \"http\" or \"https\", but nothing was "
"specified."
msgstr ""
"Das Schema der externen URL muss \"http\" oder \"https\" sein, es wurde aber "
"nichts angegeben."

#: lib/Controller/SettingsController.php:148
#, php-format
msgid ""
"Scheme of external URL must be one of \"http\" or \"https\", \"%s\" given."
msgstr ""
"Das Schema der externen URL muss \"http\" oder \"https\" sein, angegeben "
"wurde \"%s\"."

#: lib/Controller/SettingsController.php:154
msgid "Host-part of external URL seems to be empty"
msgstr "Der Host-Teil der externen URL scheint leer zu sein."

#: lib/Controller/SettingsController.php:166
msgid ""
"Value \"%1$s\" for setting \"%2$s\" is either not convertible to integer or "
"out of range (minimum is %d seconds)."
msgstr ""
"Der Wert \"%1$s\" für die Einstellung \"%2$s\" lässt sich nicht in eine "
"Ganzzahl umwandeln oder liegt außerhalb des zulässigen Bereichs (Minimum ist "
"%d Sekunden)."

#: lib/Controller/SettingsController.php:177
#, php-format
msgid "Value \"%1$s\" for setting \"%2$s\" is not convertible to boolean."
msgstr ""
"Der Wert \"%1$s\" für die Einstellung \"%2$s\" lässt sich nicht in einen "
"Wahrheitswert umwandeln."

