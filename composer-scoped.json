{
  "name": "rotdrop/nextcloud-app-redaxo",
  "description": "Support embedding an external Redaxo instance with SSO",
  "type": "project",
  "license": "AGPL-3.0-or-later",
  "authors": [
    {
      "name": "Claus-Justus Heine",
      "email": "himself@claus-justus-heine.de"
    }
  ],
  "require": {
    "rotdrop/nextcloud-app-toolkit": "dev-main"
  },
  "provide": {
    "psr/cache": "*",
    "psr/clock": "*",
    "psr/container": "*",
    "psr/log": "*",
    "symfony/console": "*"
  },
  "config": {
    "vendor-dir": "vendor-scoped",
    "optimize-autoloader": true,
    "classmap-authoritative": true,
    "platform": {
      "php": "8.4"
    }
  },
  "repositories": [
    {
      "type": "vcs",
      "url": "https://github.com/rotdrop/nextcloud-app-toolkit"
    }
  ],
  "minimum-stability": "dev",
  "prefer-stable": true
}
